@using System.Linq
@using NguyenAnhHieu_241230725.Models
@inject NguyenAnhHieu_241230725.Models.QLNhaSachContext Db
<!-- Begin Header -->
<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Hotline: <b>1900 6789</b> &nbsp;|&nbsp; Miễn phí vận chuyển đơn từ 300.000đ</span>
            <span>Đăng nhập &nbsp;|&nbsp; Đăng ký</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a href="index.html"><img src="images/logo.png" alt="BookHub" /></a>
            <div class="cart-box">Giỏ hàng: 0 sản phẩm - 0đ</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a asp-controller="Home" asp-action="Index">Nguyễn Anh Hiếu</a></li>
                @foreach (var loai in Db.Set<TheLoai>().OrderBy(x => x.MaTl))
                {
                    <li >
                        <a asp-controller="Home" asp-action="Index" asp-route-maTl="@loai.MaTl" data-matl="@loai.MaTl">@loai.TenTl</a>
                    </li >
                }
            </ul>
            <form class="search-box">
                <input type="text" placeholder="Tìm sách..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>
<!-- End Header -->